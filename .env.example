# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# .env is loaded by run.sh and is git-ignored, so your password never gets committed.

# Database role used to connect. Must match a PostgreSQL role that can access inventory_db.
DB_USERNAME=postgres

# Password for the role above. Required — the app will not start without it.
DB_PASSWORD=changeme
